# Jakoa CRM environment variables. Generated from scripts/doctor/registry.ts by npm run env:example; do not edit by hand.
# Never put real values here. Real values live only in Vercel and Supabase, entered by Jackson or Noah (docs/OWNER_TASKS.md, item VC2).
# For local work copy this file to .env.local (ignored by git) and fill in local values only.
# Each comment says: what it is. Service. OWNER_TASKS item that produces it. Secret or not. First phase that needs it. Where it must be set.

# App and domain
# Which environment this is: local, staging or production. Anything other than production can never reach real outside people. Service: App and domain. Task: VC2. Secret: no. Phase: 1. Required in: local, staging, production.
APP_ENV=local
# Public address of the app; passkeys are bound to its host name. Service: App and domain. Task: VC2. Secret: no. Phase: 1. Required in: local, staging, production.
APP_BASE_URL=http://localhost:3000
# Comma separated emails, @domains and E.164 phones that local and staging may contact; everyone else is blocked in code. Service: App and domain. Task: VC2. Secret: no. Phase: 1. Required in: local, staging.
OUTBOUND_ALLOWLIST=
# Random string that scheduled jobs present so nobody else can trigger them. Service: App and domain. Task: VC2. Secret: yes. Phase: 1. Required in: staging, production.
CRON_SECRET=
# Random string that lets npm run doctor ask the deployed app for its health without holding any other secret. Service: App and domain. Task: VC2. Secret: yes. Phase: 1. Required in: staging, production.
DOCTOR_TOKEN=

# Supabase database
# Supabase project URL, safe in the browser. Service: Supabase database. Task: SB1. Secret: no. Phase: 1. Required in: local, staging, production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key, safe in the browser because Row Level Security guards every table. Service: Supabase database. Task: SB1. Secret: no. Phase: 1. Required in: local, staging, production.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key for server code only; it bypasses Row Level Security. Service: Supabase database. Task: SB1. Secret: yes. Phase: 1. Required in: local, staging, production.
SUPABASE_SECRET_KEY=
# Postgres connection string (session pooler) used by migrations and the nightly backup. Service: Supabase database. Task: SB1. Secret: yes. Phase: 1. Required in: staging, production.
SUPABASE_DB_URL=

# Backups in Canada
# Name of the bucket that holds the nightly encrypted backup. Service: Backups in Canada. Task: BK1. Secret: no. Phase: 1. Required in: production.
BACKUP_S3_BUCKET=
# AWS region of the backup bucket; must be a Canadian region. Service: Backups in Canada. Task: BK1. Secret: no. Phase: 1. Required in: production.
BACKUP_S3_REGION=ca-west-1
# Access key id of the backup user that can only write and read that one bucket. Service: Backups in Canada. Task: BK1. Secret: yes. Phase: 1. Required in: production.
BACKUP_S3_ACCESS_KEY_ID=
# Secret access key of the backup user. Service: Backups in Canada. Task: BK1. Secret: yes. Phase: 1. Required in: production.
BACKUP_S3_SECRET_ACCESS_KEY=
# Key that encrypts every backup before it leaves Supabase; also kept in the password manager and on paper. Service: Backups in Canada. Task: BK1. Secret: yes. Phase: 1. Required in: production.
BACKUP_ENCRYPTION_KEY=
# Connection string of the scratch database the monthly restore drill fills and then wipes. Service: Backups in Canada. Task: SB2. Secret: yes. Phase: 1. Required in: production.
RESTORE_DRILL_DB_URL=

# Uptime monitoring
# Heartbeat the nightly backup calls when it succeeds; silence for a day raises an alert. Service: Uptime monitoring. Task: MON2. Secret: yes. Phase: 1. Required in: production.
BETTERSTACK_HEARTBEAT_BACKUP_URL=
# Heartbeat the daily health job calls; silence means the scheduler itself is down. Service: Uptime monitoring. Task: MON2. Secret: yes. Phase: 1. Required in: production.
BETTERSTACK_HEARTBEAT_HEALTH_URL=

# HubSpot import
# HubSpot service key with read only scopes, used for the import and the 14 day daily diff, then deleted. Service: HubSpot import. Task: HS1. Secret: yes. Phase: 1. Required in: production.
HUBSPOT_SERVICE_KEY=

# Google Gmail Calendar
# Google Cloud project id for this environment. Service: Google Gmail Calendar. Task: GC1. Secret: no. Phase: 2. Required in: staging, production.
GOOGLE_CLOUD_PROJECT_ID=
# OAuth client id of the Internal Google app. Service: Google Gmail Calendar. Task: GC6. Secret: no. Phase: 2. Required in: staging, production.
GOOGLE_OAUTH_CLIENT_ID=
# OAuth client secret of the Internal Google app. Service: Google Gmail Calendar. Task: GC6. Secret: yes. Phase: 2. Required in: staging, production.
GOOGLE_OAUTH_CLIENT_SECRET=
# Full name of the Pub/Sub topic Gmail publishes new mail notices to. Service: Google Gmail Calendar. Task: GC4. Secret: no. Phase: 2. Required in: staging, production.
GOOGLE_PUBSUB_TOPIC=
# Service account that signs each Pub/Sub push; any push signed by anyone else is rejected. Service: Google Gmail Calendar. Task: GC5. Secret: no. Phase: 2. Required in: staging, production.
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
# Mailbox the CRM reads and drafts replies in. Service: Google Gmail Calendar. Task: GC7. Secret: no. Phase: 2. Required in: staging, production.
GMAIL_MAILBOX=info@jakoa.ca
# Staging only: the Gmail label staging is allowed to process; must be empty in production. Service: Google Gmail Calendar. Task: GW4. Secret: no. Phase: 2. Required in: staging.
GMAIL_STAGING_LABEL=
# Id of the shared Jakoa calendar (a separate test calendar in staging). Service: Google Gmail Calendar. Task: GW3. Secret: no. Phase: 2. Required in: staging, production.
GOOGLE_CALENDAR_ID=
# Browser key for the Google Picker, locked to the app address, so Drive access stays per file. Service: Google Gmail Calendar. Task: GC8. Secret: no. Phase: 3. Required in: staging, production.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# Numeric Google Cloud project number, which the Picker needs as its app id. Service: Google Gmail Calendar. Task: GC1. Secret: no. Phase: 3. Required in: staging, production.
GOOGLE_CLOUD_PROJECT_NUMBER=

# Website form
# Shared secret Netlify uses to sign each website form submission it posts to the CRM. Service: Website form. Task: NF1. Secret: yes. Phase: 2. Required in: production.
NETLIFY_FORMS_JWS_SECRET=

# Inquiry form shield
# Cloudflare Turnstile site key for the hosted inquiry form. Service: Inquiry form shield. Task: TS1. Secret: no. Phase: 2. Required in: staging, production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key used by the server to verify each form. Service: Inquiry form shield. Task: TS1. Secret: yes. Phase: 2. Required in: staging, production.
TURNSTILE_SECRET_KEY=

# Claude API
# Claude API key from a workspace with a monthly spend limit; used only for the no tools extraction step. Service: Claude API. Task: AN1. Secret: yes. Phase: 2. Required in: staging, production.
ANTHROPIC_API_KEY=
# Claude model id for extraction; changing it needs no code change. Service: Claude API. Task: AN1. Secret: no. Phase: 2. Required in: staging, production.
ANTHROPIC_EXTRACTION_MODEL=claude-opus-5-5

# QuickBooks
# sandbox or production; staging must always use sandbox. Service: QuickBooks. Task: QB1. Secret: no. Phase: 3. Required in: staging, production.
QBO_ENVIRONMENT=sandbox
# Intuit app client id (sandbox keys in staging, production keys in production). Service: QuickBooks. Task: QB1. Secret: no. Phase: 3. Required in: staging, production.
QBO_CLIENT_ID=
# Intuit app client secret. Service: QuickBooks. Task: QB1. Secret: yes. Phase: 3. Required in: staging, production.
QBO_CLIENT_SECRET=
# Intuit webhook verifier token used to check the signature on every QuickBooks webhook. Service: QuickBooks. Task: QB1. Secret: yes. Phase: 3. Required in: staging, production.
QBO_WEBHOOK_VERIFIER_TOKEN=

# Twilio phone line
# Twilio Account SID (starts with AC); an identifier, not a password. Service: Twilio phone line. Task: TW1. Secret: no. Phase: 4. Required in: production.
TWILIO_ACCOUNT_SID=
# SID of the restricted API key made for this app (starts with SK). Service: Twilio phone line. Task: TW5. Secret: no. Phase: 4. Required in: production.
TWILIO_API_KEY_SID=
# Secret of the restricted API key; never the account Auth Token. Service: Twilio phone line. Task: TW5. Secret: yes. Phase: 4. Required in: production.
TWILIO_API_KEY_SECRET=
# The Jakoa tracking line in E.164 form, for example +15145550100. Service: Twilio phone line. Task: TW3. Secret: no. Phase: 4. Required in: production.
TWILIO_PHONE_NUMBER=

# Instagram Facebook
# Meta app id (created under Jackson's own profile). Service: Instagram Facebook. Task: META1. Secret: no. Phase: 4. Required in: production.
META_APP_ID=
# Meta app secret, used to check the signature on every Messenger and Instagram webhook. Service: Instagram Facebook. Task: META1. Secret: yes. Phase: 4. Required in: production.
META_APP_SECRET=
# Random string we choose and also type into the Meta webhook settings. Service: Instagram Facebook. Task: META2. Secret: yes. Phase: 4. Required in: production.
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version the app is pinned to, as shown in the Meta app dashboard. Service: Instagram Facebook. Task: META1. Secret: no. Phase: 4. Required in: production.
META_GRAPH_API_VERSION=
